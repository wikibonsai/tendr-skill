{
  "description": "Tendr garden hooks for pi. Place in .pi/hooks/ or ~/.pi/agent/hooks/",
  "hooks": {
    "session_start": [
      {
        "command": "bash scripts/load.sh",
        "timeout": 10
      }
    ],
    "user_prompt": [
      {
        "command": "bash scripts/recall.sh",
        "timeout": 15
      }
    ]
  }
}
